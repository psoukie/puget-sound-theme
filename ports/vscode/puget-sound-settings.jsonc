  "editor.tokenColorCustomizations": {
    "[Default Light Modern][Light Modern][Light 2026]": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#6A7B84",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "keyword",
            "storage",
            "storage.type",
            "keyword.control",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#7E76A6"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call"
          ],
          "settings": {
            "foreground": "#5278A7"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "storage.type.class",
            "entity.name.namespace"
          ],
          "settings": {
            "foreground": "#5592A1"
          }
        },
        {
          "scope": [
            "constant",
            "constant.numeric",
            "constant.language",
            "variable.language"
          ],
          "settings": {
            "foreground": "#5592A1"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted"
          ],
          "settings": {
            "foreground": "#708F6D"
          }
        },
        {
          "scope": [
            "string.regexp",
            "string.interpolated"
          ],
          "settings": {
            "foreground": "#B7A36F"
          }
        },
        {
          "scope": [
            "string.unquoted",
            "support.constant",
            "entity.name.tag"
          ],
          "settings": {
            "foreground": "#AA7223"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other",
            "meta.definition.variable"
          ],
          "settings": {
            "foreground": "#3E515E"
          }
        },
        {
          "scope": [
            "punctuation",
            "meta.brace",
            "meta.delimiter"
          ],
          "settings": {
            "foreground": "#5A6C74"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "entity.other.attribute-name",
            "entity.name.tag.html"
          ],
          "settings": {
            "foreground": "#7E76A6"
          }
        },
        {
          "scope": [
            "markup.heading",
            "markup.bold"
          ],
          "settings": {
            "foreground": "#375378",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link"
          ],
          "settings": {
            "foreground": "#5278A7",
            "fontStyle": "underline"
          }
        },
        {
          "scope": [
            "keyword.operator.new",
            "keyword.control.new",
            "keyword.operator.delete",
            "keyword.other.operator",
            "storage.type.class"
          ],
          "settings": {
            "foreground": "#7E76A6"
          }
        },
        {
          "scope": [
            "entity.name.type.class",
            "support.class",
            "support.type.class"
          ],
          "settings": {
            "foreground": "#5592A1"
          }
        }
      ]
    },
    "[Default Dark Modern][Dark Modern][Dark 2026]": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#87959C",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "keyword",
            "storage",
            "storage.type",
            "keyword.control",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#AAA3D6"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call"
          ],
          "settings": {
            "foreground": "#8BB2E4"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "storage.type.class",
            "entity.name.namespace"
          ],
          "settings": {
            "foreground": "#72B1BF"
          }
        },
        {
          "scope": [
            "constant",
            "constant.numeric",
            "constant.language",
            "variable.language"
          ],
          "settings": {
            "foreground": "#72B1BF"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted"
          ],
          "settings": {
            "foreground": "#90B18E"
          }
        },
        {
          "scope": [
            "string.regexp",
            "string.interpolated"
          ],
          "settings": {
            "foreground": "#D1BD88"
          }
        },
        {
          "scope": [
            "string.unquoted",
            "support.constant",
            "entity.name.tag"
          ],
          "settings": {
            "foreground": "#D79C52"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other",
            "meta.definition.variable"
          ],
          "settings": {
            "foreground": "#C1CCD3"
          }
        },
        {
          "scope": [
            "punctuation",
            "meta.brace",
            "meta.delimiter"
          ],
          "settings": {
            "foreground": "#9FADB3"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "entity.other.attribute-name",
            "entity.name.tag.html"
          ],
          "settings": {
            "foreground": "#AAA3D6"
          }
        },
        {
          "scope": [
            "markup.heading",
            "markup.bold"
          ],
          "settings": {
            "foreground": "#B2BFDB",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link"
          ],
          "settings": {
            "foreground": "#8BB2E4",
            "fontStyle": "underline"
          }
        },
        {
          "scope": [
            "keyword.operator.new",
            "keyword.control.new",
            "keyword.operator.delete",
            "keyword.other.operator",
            "storage.type.class"
          ],
          "settings": {
            "foreground": "#AAA3D6"
          }
        },
        {
          "scope": [
            "entity.name.type.class",
            "support.class",
            "support.type.class"
          ],
          "settings": {
            "foreground": "#72B1BF"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Default Light Modern][Light Modern][Light 2026]": {
      "enabled": true,
      "rules": {
        "comment": {
          "foreground": "#6A7B84",
          "italic": true
        },
        "keyword": "#7E76A6",
        "function": "#5278A7",
        "method": "#5278A7",
        "type": "#5592A1",
        "class": "#5592A1",
        "interface": "#5592A1",
        "namespace": "#5592A1",
        "enum": "#5592A1",
        "enumMember": "#5592A1",
        "parameter": "#3E515E",
        "variable": "#3E515E",
        "property": "#3E515E",
        "constant": "#5592A1",
        "number": "#708F6D",
        "string": "#708F6D",
        "regexp": "#B7A36F",
        "decorator": "#7E76A6",
        "label": "#7E76A6"
      }
    },
    "[Default Dark Modern][Dark Modern][Dark 2026]": {
      "enabled": true,
      "rules": {
        "comment": {
          "foreground": "#87959C",
          "italic": true
        },
        "keyword": "#AAA3D6",
        "function": "#8BB2E4",
        "method": "#8BB2E4",
        "type": "#72B1BF",
        "class": "#72B1BF",
        "interface": "#72B1BF",
        "namespace": "#72B1BF",
        "enum": "#72B1BF",
        "enumMember": "#72B1BF",
        "parameter": "#C1CCD3",
        "variable": "#C1CCD3",
        "property": "#C1CCD3",
        "constant": "#72B1BF",
        "number": "#90B18E",
        "string": "#90B18E",
        "regexp": "#D1BD88",
        "decorator": "#AAA3D6",
        "label": "#AAA3D6"
      }
    }
  }
}
